# Copiá este archivo como ".env" (sin ".example") y completá los valores
# reales. El ".env" real nunca se sube a Git (está en .gitignore).

# URL pública del backend (en producción, la de Railway o el dominio final).
VITE_API_URL=http://localhost:8080

# Public Key de Mercado Pago (la misma que MP_PUBLIC_KEY del backend —
# esta es la que puede verse en el navegador, no es secreta).
VITE_MP_PUBLIC_KEY=
